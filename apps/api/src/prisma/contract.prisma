enum StockMovementType {
  @@type("pg/text@1")

  purchase = "purchase"
  transfer = "transfer"
  return_in = "return_in"
  return_out = "return_out"
  damage = "damage"
  sale = "sale"
  adjustment_in = "adjustment_in"
  adjustment_out = "adjustment_out"
}

enum UserRole {
  @@type("pg/text@1")

  administrator = "administrator"
  inventory_manager = "inventory_manager"
  shop_attendant = "shop_attendant"
}

enum LocationType {
  @@type("pg/text@1")

  warehouse = "warehouse"
  shop = "shop"
}

model Company {
  id                    Uuid                       @id @default(uuid())
  name                  VarChar(120)
  businessType          VarChar(40)?               @map("business_type")
  inventorySource       VarChar(40)?               @map("inventory_source")
  contactEmail          VarChar(255)?              @map("contact_email")
  phone                 VarChar(40)?
  address               VarChar(300)?
  currency              VarChar(3)                 @default("GHS")
  timeZone              VarChar(64)                @default("Africa/Accra") @map("time_zone")
  dateFormat            VarChar(24)                @default("day_month_year") @map("date_format")
  defaultLocationId     Uuid?                      @map("default_location_id")
  defaultUnit           VarChar(20)                @default("pcs") @map("default_unit")
  defaultReorderLevel   Int                        @default(10) @map("default_reorder_level")
  skuPrefix             VarChar(12)                @default("SKU") @map("sku_prefix")
  nextSkuNumber         Int                        @default(1) @map("next_sku_number")
  allowNegativeStock    Boolean                    @default(false) @map("allow_negative_stock")
  requirePurchaseSource Boolean                    @default(false) @map("require_purchase_source")
  requireAdjustmentReason Boolean                  @default(true) @map("require_adjustment_reason")
  hybridPricingEnabled  Boolean                    @default(false) @map("hybrid_pricing_enabled")
  shopTerm              VarChar(20)                @default("shop") @map("shop_term")
  warehouseTerm         VarChar(20)                @default("warehouse") @map("warehouse_term")
  itemTerm              VarChar(20)                @default("item") @map("item_term")
  onboardingCompletedAt TimestamptzString?         @map("onboarding_completed_at")
  createdAt             TimestamptzString          @default(now()) @map("created_at")
  updatedAt             temporal.updatedAtString() @map("updated_at")

  @@rls
  @@map("companies")
}

model Location {
  id        Uuid                       @id @default(uuid())
  companyId Uuid                       @map("company_id")
  name      VarChar(120)
  type      LocationType
  createdAt TimestamptzString          @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")

  company   Company                    @relation(fields:[companyId], references:[id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId])
  @@rls
  @@map("locations")
}

model User {
  id                         Uuid                       @id @default(uuid())
  companyId                  Uuid                       @map("company_id")
  locationId                 Uuid?                      @map("location_id")
  fullName                   VarChar(120)               @map("full_name")
  email                      VarChar(255)               @unique
  passwordHash               VarChar(255)               @map("password_hash")
  role                       UserRole                   @default(inventory_manager)
  isActive                   Boolean                    @default(true) @map("is_active")
  emailVerifiedAt            TimestamptzString?         @map("email_verified_at")
  emailVerificationTokenHash VarChar(64)?               @unique @map("email_verification_token_hash")
  emailVerificationExpiresAt TimestamptzString?         @map("email_verification_expires_at")
  invitationAcceptedAt       TimestamptzString?         @map("invitation_accepted_at")
  invitationTokenHash        VarChar(64)?               @unique @map("invitation_token_hash")
  invitationExpiresAt        TimestamptzString?         @map("invitation_expires_at")
  passwordResetTokenHash     VarChar(64)?               @unique @map("password_reset_token_hash")
  passwordResetExpiresAt     TimestamptzString?         @map("password_reset_expires_at")
  createdAt                  TimestamptzString          @default(now()) @map("created_at")
  updatedAt                  temporal.updatedAtString() @map("updated_at")

  company                    Company                    @relation(fields:[companyId], references:[id], onDelete: Restrict, onUpdate: Cascade)
  location                   Location?                  @relation(fields:[companyId, locationId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@check(expression: "role <> 'shop_attendant' OR location_id IS NOT NULL", name: "user_shop_attendant_has_location")
  @@unique([companyId, id])
  @@index([companyId])
  @@rls
  @@map("users")
}

model InventoryItem {
  id                Uuid                       @id @default(uuid())
  companyId         Uuid                       @map("company_id")
  sku               VarChar(40)
  name              VarChar(120)
  category          VarChar(80)
  unit              VarChar(20)
  reorderLevel      Int                        @default(0) @map("reorder_level")
  unitCostCents     Int                        @default(0) @map("unit_cost_cents")
  sellingPriceCents Int?                       @map("selling_price_cents")
  isActive          Boolean                    @default(true) @map("is_active")
  createdAt         TimestamptzString          @default(now()) @map("created_at")
  updatedAt         temporal.updatedAtString() @map("updated_at")

  company           Company                    @relation(fields:[companyId], references:[id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, sku])
  @@unique([companyId, id])
  @@check(expression: "reorder_level >= 0", name: "inventory_item_reorder_level_nonnegative")
  @@check(expression: "unit_cost_cents >= 0", name: "inventory_item_unit_cost_nonnegative")
  @@check(expression: "selling_price_cents IS NULL OR selling_price_cents >= 0", name: "inventory_item_selling_price_nonnegative")
  @@index([companyId])
  @@rls
  @@map("inventory_items")
}

model ItemPricingVersion {
  id                  Uuid              @id @default(uuid())
  companyId           Uuid              @map("company_id")
  itemId              Uuid              @map("item_id")
  version             Int
  baseUnit            VarChar(20)       @map("base_unit")
  previewEnabled      Boolean           @default(false) @map("preview_enabled")
  packageLabel        VarChar(20)?      @map("package_label")
  packageSize         Int?              @map("package_size")
  packagePriceCents   Int?              @map("package_price_cents")
  bulkTiers           Jsonb             @map("bulk_tiers")
  createdByUserId     Uuid              @map("created_by_user_id")
  createdAt           TimestamptzString @default(now()) @map("created_at")

  item                InventoryItem     @relation(fields:[companyId, itemId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  createdBy           User              @relation(fields:[companyId, createdByUserId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, itemId, version])
  @@check(expression: "version > 0", name: "item_pricing_version_positive")
  @@check(expression: "length(btrim(base_unit)) > 0", name: "item_pricing_base_unit_present")
  @@check(expression: "(package_label IS NULL AND package_size IS NULL AND package_price_cents IS NULL) OR (package_label IS NOT NULL AND length(btrim(package_label)) > 0 AND package_size IS NOT NULL AND package_size > 1 AND package_price_cents IS NOT NULL AND package_price_cents >= 0)", name: "item_pricing_package_valid")
  @@check(expression: "jsonb_typeof(bulk_tiers) = 'array'", name: "item_pricing_tiers_array")
  @@index([companyId])
  @@index([companyId, createdByUserId], map: "item_pricing_actor_idx")
  @@rls
  @@map("item_pricing_versions")
}

// Prospective exact carrying values. No legacy rows are enrolled or backfilled.
model InventoryValuationRequest {
  id Uuid @id @default(uuid())
  companyId Uuid @map("company_id")
  requestKey Uuid @map("request_key")
  createdByUserId Uuid @map("created_by_user_id")
  itemId Uuid? @map("item_id")
  inputJson Jsonb? @map("input_json")
  inputHash VarChar(64)? @map("input_hash")
  status VarChar(12)
  createdAt TimestamptzString @default(now()) @map("created_at")
  finishedAt TimestamptzString? @map("finished_at")

  company Company @relation(fields:[companyId], references:[id], onDelete: Restrict, onUpdate: Cascade)
  actor User @relation(fields:[companyId, createdByUserId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  item InventoryItem? @relation(fields:[companyId, itemId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, id])
  @@unique([companyId, requestKey])
  @@check(expression: "status IN ('prepared','applied','cancelled') AND ((status = 'prepared' AND finished_at IS NULL) OR (status <> 'prepared' AND finished_at IS NOT NULL)) AND ((item_id IS NOT NULL AND input_json IS NOT NULL AND input_hash IS NOT NULL) OR (status = 'cancelled' AND item_id IS NULL AND input_json IS NULL AND input_hash IS NULL))", name: "valuation_request_valid")
  @@index([companyId, itemId])
  @@rls
  @@map("inventory_valuation_requests")
}

model InventoryValuationCheckpoint {
  id Uuid @id @default(uuid())
  companyId Uuid @map("company_id")
  itemId Uuid @map("item_id")
  requestId Uuid @map("request_id")
  createdByUserId Uuid @map("created_by_user_id")
  baseUnit VarChar(20) @map("base_unit")
  currency VarChar(3)
  openingQuantity Int @map("opening_quantity")
  openingValueCents Int @map("opening_value_cents")
  reference VarChar(200)
  costReviewId Uuid? @map("cost_review_id")
  createdAt TimestamptzString @default(now()) @map("created_at")

  item InventoryItem @relation(fields:[companyId, itemId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  request InventoryValuationRequest @relation(fields:[companyId, requestId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  actor User @relation(fields:[companyId, createdByUserId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, itemId])
  @@unique([companyId, itemId, id])
  @@unique([companyId, requestId])
  @@check(expression: "opening_quantity >= 0 AND opening_value_cents >= 0 AND (opening_quantity > 0 OR opening_value_cents = 0) AND length(btrim(reference)) > 0 AND length(btrim(base_unit)) > 0", name: "valuation_checkpoint_valid")
  @@rls
  @@map("inventory_valuation_checkpoints")
}

model InventoryValuationEntry {
  id Uuid @id @default(uuid())
  companyId Uuid @map("company_id")
  itemId Uuid @map("item_id")
  checkpointId Uuid @map("checkpoint_id")
  requestId Uuid? @map("request_id")
  movementId Uuid? @map("movement_id")
  createdByUserId Uuid @map("created_by_user_id")
  sequence Int
  kind VarChar(20)
  quantityDelta Int @map("quantity_delta")
  valueDeltaCents Int @map("value_delta_cents")
  quantityAfter Int @map("quantity_after")
  valueAfterCents Int @map("value_after_cents")
  reference VarChar(200)
  createdAt TimestamptzString @default(now()) @map("created_at")

  checkpoint InventoryValuationCheckpoint @relation(fields:[companyId, itemId, checkpointId], references:[companyId, itemId, id], onDelete: Restrict, onUpdate: Cascade)
  request InventoryValuationRequest? @relation(fields:[companyId, requestId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  movement StockMovement? @relation(fields:[companyId, movementId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  actor User @relation(fields:[companyId, createdByUserId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, itemId, sequence])
  @@unique([companyId, movementId])
  @@index([companyId, requestId])
  @@check(expression: "sequence > 0 AND quantity_after >= 0 AND value_after_cents >= 0 AND (quantity_after > 0 OR value_after_cents = 0) AND length(btrim(reference)) > 0 AND ((kind = 'receipt' AND quantity_delta > 0 AND value_delta_cents >= 0 AND movement_id IS NOT NULL AND request_id IS NOT NULL) OR (kind = 'sale' AND quantity_delta < 0 AND value_delta_cents <= 0 AND movement_id IS NOT NULL AND request_id IS NULL) OR (kind = 'customer_return' AND quantity_delta > 0 AND value_delta_cents >= 0 AND movement_id IS NOT NULL AND request_id IS NULL) OR (kind = 'return_disposal' AND quantity_delta = 0 AND value_delta_cents = 0 AND movement_id IS NOT NULL AND request_id IS NULL) OR (kind IN ('damage','count_out','supplier_return','receipt_reversal') AND quantity_delta < 0 AND value_delta_cents <= 0 AND movement_id IS NOT NULL AND request_id IS NOT NULL) OR (kind = 'count_in' AND quantity_delta > 0 AND value_delta_cents >= 0 AND movement_id IS NOT NULL AND request_id IS NOT NULL) OR (kind = 'transfer' AND quantity_delta = 0 AND value_delta_cents = 0 AND movement_id IS NOT NULL AND request_id IS NOT NULL) OR (kind = 'count_check' AND quantity_delta = 0 AND value_delta_cents = 0 AND movement_id IS NULL AND request_id IS NOT NULL) OR (kind = 'value_adjustment' AND quantity_delta = 0 AND movement_id IS NULL AND request_id IS NOT NULL))", name: "valuation_entry_valid")
  @@rls
  @@map("inventory_valuation_entries")
}

// Completed development sales only. Legacy movements are neither backfilled nor reclassified.
model Sale {
  id                     Uuid              @id @default(uuid())
  companyId              Uuid              @map("company_id")
  locationId             Uuid              @map("location_id")
  createdByUserId        Uuid              @map("created_by_user_id")
  idempotencyKey         Uuid              @map("idempotency_key")
  requestHash            VarChar(64)       @map("request_hash")
  currency               VarChar(3)
  movementDate           DateString        @map("movement_date")
  grossSalesCents        Int               @map("gross_sales_cents")
  automaticDiscountCents Int               @map("automatic_discount_cents")
  totalCents             Int               @map("total_cents")
  cogsCents              Int               @map("cogs_cents")
  createdAt              TimestamptzString @default(now()) @map("created_at")

  location               Location @relation(fields:[companyId, locationId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  createdBy              User @relation(fields:[companyId, createdByUserId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, id])
  @@unique([companyId, idempotencyKey])
  @@check(expression: "gross_sales_cents >= 0 AND automatic_discount_cents >= 0 AND total_cents >= 0 AND cogs_cents >= 0 AND gross_sales_cents::bigint - automatic_discount_cents = total_cents", name: "sale_amounts_valid")
  @@index([companyId, locationId, createdAt])
  @@index([companyId, createdByUserId])
  @@rls
  @@map("sales")
}

model SaleLine {
  id                     Uuid              @id @default(uuid())
  companyId              Uuid              @map("company_id")
  saleId                 Uuid              @map("sale_id")
  itemId                 Uuid              @map("item_id")
  position               Int
  itemName               VarChar(120)      @map("item_name")
  sku                    VarChar(40)
  category               VarChar(80)
  baseUnit               VarChar(20)       @map("base_unit")
  quantity               Int
  retailPriceCents        Int               @map("retail_price_cents")
  unitCostCents           Int               @map("unit_cost_cents")
  grossSalesCents         Int               @map("gross_sales_cents")
  automaticDiscountCents  Int               @map("automatic_discount_cents")
  totalCents              Int               @map("total_cents")
  cogsCents               Int               @map("cogs_cents")
  pricingSnapshot         Jsonb             @map("pricing_snapshot")
  valuationCheckpointId Uuid? @map("valuation_checkpoint_id")

  valuationCheckpoint InventoryValuationCheckpoint? @relation(fields:[companyId, itemId, valuationCheckpointId], references:[companyId, itemId, id], onDelete: Restrict, onUpdate: Cascade)

  sale                    Sale @relation(fields:[companyId, saleId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  item                    InventoryItem @relation(fields:[companyId, itemId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, id])
  @@unique([companyId, saleId, itemId])
  @@unique([companyId, saleId, position])
  @@check(expression: "position >= 0 AND quantity > 0 AND retail_price_cents >= 0 AND unit_cost_cents >= 0 AND gross_sales_cents::bigint = quantity::bigint * retail_price_cents AND cogs_cents >= 0 AND (valuation_checkpoint_id IS NOT NULL OR cogs_cents::bigint = quantity::bigint * unit_cost_cents) AND total_cents >= 0 AND automatic_discount_cents >= 0 AND gross_sales_cents::bigint - automatic_discount_cents = total_cents", name: "sale_line_amounts_valid")
  @@index([companyId, itemId])
  @@rls
  @@map("sale_lines")
}

model SaleComponent {
  id             Uuid        @id @default(uuid())
  companyId      Uuid        @map("company_id")
  saleLineId     Uuid        @map("sale_line_id")
  movementId     Uuid        @map("movement_id")
  position       Int
  category       VarChar(10)
  quantity       Int
  unitPriceCents Int         @map("unit_price_cents")
  totalCents     Int         @map("total_cents")

  line           SaleLine @relation(fields:[companyId, saleLineId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  movement       StockMovement @relation(fields:[companyId, movementId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, movementId])
  @@unique([companyId, saleLineId, position])
  @@check(expression: "position >= 0 AND quantity > 0 AND unit_price_cents >= 0 AND total_cents::bigint = quantity::bigint * unit_price_cents AND category IN ('retail', 'bulk', 'box')", name: "sale_component_valid")
  @@rls
  @@map("sale_components")
}


model SaleReturnRequest {
  id Uuid @id @default(uuid())
  companyId Uuid @map("company_id")
  requestKey Uuid @map("request_key")
  createdByUserId Uuid @map("created_by_user_id")
  inputJson Jsonb? @map("input_json")
  previewJson Jsonb? @map("preview_json")
  inputHash VarChar(64)? @map("input_hash")
  status VarChar(12)
  createdAt TimestamptzString @default(now()) @map("created_at")
  finishedAt TimestamptzString? @map("finished_at")
  company Company @relation(fields:[companyId], references:[id], onDelete: Restrict, onUpdate: Cascade)
  actor User @relation(fields:[companyId,createdByUserId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId,id])
  @@unique([companyId,requestKey])
  @@check(expression: "status IN ('prepared','applied','cancelled') AND ((status = 'prepared' AND finished_at IS NULL) OR (status <> 'prepared' AND finished_at IS NOT NULL)) AND ((input_json IS NOT NULL AND preview_json IS NOT NULL AND input_hash IS NOT NULL) OR (status = 'cancelled' AND input_json IS NULL AND preview_json IS NULL AND input_hash IS NULL))", name: "sale_return_request_valid")
  @@rls
  @@map("sale_return_requests")
}
model SaleReturn {
  id Uuid @id @default(uuid())
  companyId Uuid @map("company_id")
  requestId Uuid @map("request_id")
  sourceSaleId Uuid? @map("source_sale_id")
  legacyMovementId Uuid? @map("legacy_movement_id")
  locationId Uuid @map("location_id")
  createdByUserId Uuid @map("created_by_user_id")
  kind VarChar(12)
  currency VarChar(3)
  movementDate DateString @map("movement_date")
  refundCents Int @map("refund_cents")
  cogsCents Int @map("cogs_cents")
  reason VarChar(200)
  reference VarChar(200)
  createdAt TimestamptzString @default(now()) @map("created_at")
  request SaleReturnRequest @relation(fields:[companyId,requestId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  sale Sale? @relation(fields:[companyId,sourceSaleId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  legacy StockMovement? @relation("return_legacy", fields:[companyId,legacyMovementId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  location Location @relation(fields:[companyId,locationId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  actor User @relation(fields:[companyId,createdByUserId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId,id])
  @@unique([companyId,requestId])
  @@check(expression: "(source_sale_id IS NULL) <> (legacy_movement_id IS NULL) AND kind IN ('return','reversal') AND refund_cents >= 0 AND cogs_cents >= 0 AND length(btrim(reason)) > 0 AND length(btrim(reference)) > 0", name: "sale_return_valid")
  @@rls
  @@map("sale_returns")
}
model SaleReturnAllocation {
  id Uuid @id @default(uuid())
  companyId Uuid @map("company_id")
  returnId Uuid @map("return_id")
  itemId Uuid @map("item_id")
  originalMovementId Uuid @map("original_movement_id")
  returnMovementId Uuid @map("return_movement_id")
  lossMovementId Uuid? @map("loss_movement_id")
  position Int
  quantity Int
  unitPriceCents Int @map("unit_price_cents")
  unitCostCents Int @map("unit_cost_cents")
  refundCents Int @map("refund_cents")
  cogsCents Int @map("cogs_cents")
  disposition VarChar(12)
  returned SaleReturn @relation(fields:[companyId,returnId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  item InventoryItem @relation(fields:[companyId,itemId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  original StockMovement @relation("return_original",fields:[companyId,originalMovementId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  movement StockMovement @relation("return_restock",fields:[companyId,returnMovementId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  loss StockMovement? @relation("return_loss",fields:[companyId,lossMovementId], references:[companyId,id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([companyId,returnId,position])
  @@unique([companyId,returnMovementId])
  @@unique([companyId,lossMovementId])
  @@check(expression: "position >= 0 AND quantity > 0 AND unit_price_cents >= 0 AND unit_cost_cents >= 0 AND refund_cents::bigint = quantity::bigint * unit_price_cents AND cogs_cents::bigint = quantity::bigint * unit_cost_cents AND ((disposition = 'resellable' AND loss_movement_id IS NULL) OR (disposition = 'damaged' AND loss_movement_id IS NOT NULL))", name: "sale_return_allocation_valid")
  @@rls
  @@map("sale_return_allocations")
}

model Supplier {
  id        Uuid                       @id @default(uuid())
  companyId Uuid                       @map("company_id")
  name      VarChar(120)
  email     VarChar(255)?
  phone     VarChar(40)?
  address   VarChar(300)?
  isActive  Boolean                    @default(true) @map("is_active")
  createdAt TimestamptzString          @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")

  company   Company                    @relation(fields:[companyId], references:[id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId])
  @@rls
  @@map("suppliers")
}

model LocationStock {
  id           Uuid                       @id @default(uuid())
  companyId    Uuid                       @map("company_id")
  locationId   Uuid                       @map("location_id")
  itemId       Uuid                       @map("item_id")
  openingStock Int                        @default(0) @map("opening_stock")
  createdAt    TimestamptzString          @default(now()) @map("created_at")
  updatedAt    temporal.updatedAtString() @map("updated_at")

  location     Location                   @relation(fields:[companyId, locationId], references:[companyId, id], onDelete: Cascade, onUpdate: Cascade)
  item         InventoryItem              @relation(fields:[companyId, itemId], references:[companyId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([companyId, locationId, itemId])
  @@check(expression: "opening_stock >= 0", name: "location_stock_opening_nonnegative")
  @@index([companyId])
  @@index([itemId])
  @@rls
  @@map("location_stocks")
}

model StockMovement {
  id                    Uuid              @id @default(uuid())
  companyId             Uuid              @map("company_id")
  itemId                Uuid              @map("item_id")
  locationId            Uuid              @map("location_id")
  destinationLocationId Uuid?             @map("destination_location_id")
  type                  StockMovementType
  quantity              Int
  unitPriceCents        Int?              @map("unit_price_cents")
  unitCostCents         Int?              @map("unit_cost_cents")
  supplierId            Uuid?             @map("supplier_id")
  relatedMovementId     Uuid?             @map("related_movement_id")
  stockCountId          Uuid?             @map("stock_count_id")
  movementDate          DateString        @map("movement_date")
  reference             VarChar(80)?
  note                  VarChar(500)?
  createdAt             TimestamptzString @default(now()) @map("created_at")

  item                  InventoryItem     @relation(fields:[companyId, itemId], references:[companyId, id], onDelete: Cascade, onUpdate: Cascade)
  location              Location          @relation("movement_source", fields:[companyId, locationId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  destination           Location?         @relation("movement_destination", fields:[companyId, destinationLocationId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  supplier              Supplier?         @relation(fields:[companyId, supplierId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  relatedMovement       StockMovement?    @relation("movement_relation", fields:[companyId, relatedMovementId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  stockCount            StockCount?       @relation(fields:[companyId, stockCountId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, id])
  @@check(expression: "quantity > 0", name: "stock_movement_quantity_positive")
  @@check(expression: "unit_price_cents IS NULL OR (type IN ('sale', 'return_in') AND unit_price_cents >= 0)", name: "stock_movement_sale_price_valid")
  @@check(expression: "unit_cost_cents IS NULL OR unit_cost_cents >= 0", name: "stock_movement_unit_cost_nonnegative")
  @@check(expression: "supplier_id IS NULL OR type = 'purchase'", name: "stock_movement_supplier_purchase_only")
  @@check(expression: "related_movement_id IS NULL OR type = 'return_in'", name: "stock_movement_relation_return_only")
  @@check(expression: "stock_count_id IS NULL OR type IN ('adjustment_in', 'adjustment_out')", name: "stock_movement_count_adjustment_only")
  @@check(expression: "destination_location_id IS NULL OR destination_location_id <> location_id", name: "stock_movement_destination_differs")
  @@index([companyId])
  @@index([itemId])
  @@index([locationId])
  @@index([destinationLocationId])
  @@index([supplierId])
  @@index([relatedMovementId])
  @@index([stockCountId])
  @@index([movementDate])
  @@rls
  @@map("stock_movements")
}

model StockCount {
  id               Uuid              @id @default(uuid())
  companyId        Uuid              @map("company_id")
  itemId           Uuid              @map("item_id")
  locationId       Uuid              @map("location_id")
  countedByUserId  Uuid              @map("counted_by_user_id")
  expectedQuantity Int               @map("expected_quantity")
  countedQuantity  Int               @map("counted_quantity")
  varianceQuantity Int               @map("variance_quantity")
  unitCostCents    Int               @map("unit_cost_cents")
  countedAt        DateString        @map("counted_at")
  note             VarChar(500)?
  createdAt        TimestamptzString @default(now()) @map("created_at")

  item             InventoryItem     @relation(fields:[companyId, itemId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  location         Location          @relation(fields:[companyId, locationId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)
  countedBy        User              @relation(fields:[companyId, countedByUserId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, id])
  @@check(expression: "expected_quantity >= 0", name: "stock_count_expected_nonnegative")
  @@check(expression: "counted_quantity >= 0", name: "stock_count_counted_nonnegative")
  @@check(expression: "variance_quantity = counted_quantity - expected_quantity", name: "stock_count_variance_matches")
  @@check(expression: "unit_cost_cents >= 0", name: "stock_count_unit_cost_nonnegative")
  @@index([companyId])
  @@index([itemId])
  @@index([locationId])
  @@index([countedAt])
  @@rls
  @@map("stock_counts")
}

model RefreshSession {
  id        Uuid                       @id @default(uuid())
  companyId Uuid                       @map("company_id")
  userId    Uuid                       @map("user_id")
  tokenHash VarChar(64)                @unique @map("token_hash")
  expiresAt TimestamptzString          @map("expires_at")
  userAgent VarChar(300)?              @map("user_agent")
  ipAddress VarChar(64)?               @map("ip_address")
  lastUsedAt TimestamptzString         @default(now()) @map("last_used_at")
  createdAt TimestamptzString          @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")

  user      User                       @relation(fields:[companyId, userId], references:[companyId, id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId])
  @@index([userId])
  @@rls
  @@map("refresh_sessions")
}

model AuditEvent {
  id          Uuid              @id @default(uuid())
  companyId   Uuid              @map("company_id")
  actorUserId Uuid?             @map("actor_user_id")
  action      VarChar(80)
  entityType  VarChar(80)       @map("entity_type")
  entityId    Uuid?             @map("entity_id")
  metadata    Jsonb
  createdAt   TimestamptzString @default(now()) @map("created_at")

  actor       User?             @relation(fields:[companyId, actorUserId], references:[companyId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId, createdAt])
  @@index([actorUserId])
  @@rls
  @@map("audit_events")
}

