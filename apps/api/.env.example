NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://stockledger:stockledger@localhost:5434/stockledger"
# Optional direct connection for migrations. The API always uses DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://stockledger:stockledger@localhost:5434/stockledger"
JWT_SECRET="replace-this-with-at-least-32-random-characters"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
INVITATION_TTL_HOURS=72
# Keep the seeded public workspace read-only. Leave blank if no demo is exposed.
DEMO_COMPANY_ID="31000000-0000-4000-8000-000000000001"
# Optional company allowlist for pricing configuration and preview only. Never enables checkout.
PRICING_PREVIEW_COMPANY_IDS=
# Optional error reporting. Create separate Sentry projects for the API and web app.
SENTRY_DSN=
RESEND_API_KEY=
EMAIL_FROM="StockLedger <accounts@your-domain.com>"

# Development/test only; ignored by production. Requires the preview allowlist too.
SALE_COMPLETION_COMPANY_IDS=

# Optional current-cost review; development/test only, disabled by default.
COST_READINESS_COMPANY_IDS=

# Development/test only; selected synthetic companies. Existing items need explicit enrollment.
EXACT_COSTING_COMPANY_IDS=

# Development/test only; explicitly selected companies.
SALE_RETURNS_COMPANY_IDS=
STOCK_OPERATIONS_COMPANY_IDS=
