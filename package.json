{
  "name": "stockledger",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.22.1 <27"
  },
  "scripts": {
    "api:dev": "npm run start:dev --workspace=apps/api",
    "api:build": "npm run build --workspace=apps/api",
    "api:test": "npm run test --workspace=apps/api",
    "api:test:integration": "npm run test:integration --workspace=apps/api",
    "api:migrate": "npm run db:migrate --workspace=apps/api",
    "api:seed": "npm run db:seed --workspace=apps/api",
    "web:dev": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "web:lint": "npm run lint --workspace=apps/web",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "security:check": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.63.0"
  }
}
